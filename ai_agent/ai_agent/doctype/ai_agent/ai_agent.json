{
 "$schema": "https://frappeframework.io/files/v16_docfield.json",
 "name": "AI Agent",
 "module": "AI Agent",
 "doctype": "DocType",
 "engine": "InnoDB",
 "document_type": "Document",
 "is_submittable": 0,
 "issingle": 0,
 "istable": 0,
 "is_tree": 0,
 "editable_grid": 0,
 "track_changes": 0,
 "autoname": "field:agent_name",
 "naming_rule": "By fieldname",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "section_general",
   "fieldtype": "Section Break",
   "label": "General"
  },
  {
   "fieldname": "agent_name",
   "fieldtype": "Data",
   "label": "Agent Name",
   "unique": 1,
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "column_break_general",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Is Default"
  },
  {
   "fieldname": "system_instructions",
   "fieldtype": "Long Text",
   "label": "System Instructions"
  },
  {
   "fieldname": "model",
   "fieldtype": "Data",
   "label": "Model"
  },
  {
   "fieldname": "reasoning_effort",
   "fieldtype": "Select",
   "label": "Reasoning Effort",
   "options": "low\nmedium\nhigh",
   "default": "medium"
  },
  {
   "fieldname": "section_limits",
   "fieldtype": "Section Break",
   "label": "Limits"
  },
  {
   "fieldname": "maximum_steps",
   "fieldtype": "Int",
   "label": "Maximum Steps"
  },
  {
   "fieldname": "maximum_tool_calls",
   "fieldtype": "Int",
   "label": "Maximum Tool Calls"
  },
  {
   "fieldname": "column_break_limits",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "read_only",
   "fieldtype": "Check",
   "label": "Read Only",
   "default": "1"
  },
  {
   "fieldname": "section_actions",
   "fieldtype": "Section Break",
   "label": "Actions"
  },
  {
   "fieldname": "allow_actions",
   "fieldtype": "Check",
   "label": "Allow Actions"
  },
  {
   "fieldname": "column_break_actions",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "require_approval_for_all_writes",
   "fieldtype": "Check",
   "label": "Require Approval for All Writes",
   "default": "1"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  }
 ]
}
{
    "name": "AI Memory",
    "module": "AI Agent",
    "doctype": "DocType",
    "engine": "InnoDB",
    "fields": [
        {
            "fieldname": "scope",
            "fieldtype": "Select",
            "options": "User\nCompany\nAgent",
            "default": "User",
            "reqd": 1,
            "in_list_view": 1,
            "label": "Scope"
        },
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "options": "User",
            "mandatory_depends_on": "eval:doc.scope!='Agent'",
            "in_list_view": 1,
            "label": "User"
        },
        {
            "fieldname": "agent",
            "fieldtype": "Link",
            "options": "AI Agent",
            "depends_on": "eval:doc.scope=='Agent'",
            "mandatory_depends_on": "eval:doc.scope=='Agent'",
            "in_list_view": 1,
            "label": "Agent"
        },
        {
            "fieldname": "company",
            "fieldtype": "Link",
            "options": "Company",
            "depends_on": "eval:doc.scope=='Company' || doc.scope=='Agent'",
            "mandatory_depends_on": "eval:doc.scope=='Company'",
            "in_list_view": 1,
            "label": "Company"
        },
        {
            "fieldname": "source_run",
            "fieldtype": "Link",
            "options": "AI Run",
            "read_only": 1,
            "label": "Source Run"
        },
        {
            "fieldname": "memory_type",
            "fieldtype": "Select",
            "options": "Preference\nContext\nSummary\nMapping",
            "reqd": 1,
            "in_list_view": 1,
            "label": "Memory Type"
        },
        {
            "fieldname": "content",
            "fieldtype": "Long Text",
            "reqd": 1,
            "label": "Content"
        },
        {
            "fieldname": "entity_type",
            "fieldtype": "Data",
            "label": "Entity Type",
            "description": "What the memory is about: Supplier, Cash Supplier, Customer, Account, Item, ..."
        },
        {
            "fieldname": "entity_key",
            "fieldtype": "Data",
            "label": "Entity Key",
            "search_index": 1,
            "description": "Arabic-normalized entity name used for relevance lookup and mapping upserts."
        },
        {
            "fieldname": "mapping_json",
            "fieldtype": "Small Text",
            "label": "Mapping JSON",
            "description": "Structured fact for Mapping memories, e.g. {\"account\": ..., \"cost_center\": ...}."
        },
        {
            "fieldname": "usage_count",
            "fieldtype": "Int",
            "label": "Usage Count",
            "default": "0"
        },
        {
            "fieldname": "expires_at",
            "fieldtype": "Datetime",
            "label": "Expires At"
        },
        {
            "fieldname": "sensitivity",
            "fieldtype": "Select",
            "options": "Low\nMedium\nHigh",
            "default": "Low",
            "label": "Sensitivity"
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "submit": 0,
            "cancel": 0,
            "amend": 0
        }
    ],
    "sort_field": "modified",
    "sort_order": "DESC",
    "title_field": "content",
    "track_changes": 1
}

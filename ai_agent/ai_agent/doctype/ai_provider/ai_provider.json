{
 "name": "AI Provider",
 "module": "AI Agent",
 "doctype": "DocType",
 "engine": "InnoDB",
 "autoname": "field:provider_name",
 "title_field": "provider_name",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "provider_name",
   "fieldtype": "Data",
   "label": "Provider Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Is Default",
   "in_list_view": 1,
   "description": "Used when a run or agent does not pick a provider. Only one provider can be default."
  },
  {
   "fieldname": "cb_identity",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "provider_type",
   "fieldtype": "Select",
   "label": "Provider Type",
   "options": "OpenAI\nOpenAI Compatible\nOllama\nAnthropic",
   "default": "OpenAI Compatible",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Anthropic uses the native Messages API (official SDK) with prompt caching; base_url may point to a proxy."
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "section_connection",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "fieldname": "base_url",
   "fieldtype": "Data",
   "label": "Base URL",
   "description": "e.g. https://api.deepseek.com/v1 or http://localhost:11434/v1 (leave empty for OpenAI)"
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key"
  },
  {
   "fieldname": "cb_connection",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "request_timeout",
   "fieldtype": "Int",
   "label": "Request Timeout (seconds)",
   "description": "Leave empty to use AI Settings"
  },
  {
   "fieldname": "strict_tool_calling",
   "fieldtype": "Check",
   "label": "Strict Tool Calling"
  },
  {
   "fieldname": "default_reasoning_effort",
   "fieldtype": "Select",
   "label": "Default Reasoning Effort",
   "options": "\nlow\nmedium\nhigh"
  },
  {
   "fieldname": "section_models",
   "fieldtype": "Section Break",
   "label": "Models"
  },
  {
   "fieldname": "default_model",
   "fieldtype": "Data",
   "label": "Default Model",
   "description": "Falls back to the row marked Default in the table, then to AI Settings"
  },
  {
   "fieldname": "models",
   "fieldtype": "Table",
   "label": "Available Models",
   "options": "AI Provider Model",
   "description": "These appear in the Agent Workspace model picker for this provider."
  },
  {
   "fieldname": "extra_request_json",
   "fieldtype": "Code",
   "label": "Extra Request JSON",
   "options": "JSON",
   "description": "Merged into every request body (e.g. {\"thinking\": {\"type\": \"enabled\"}} for DeepSeek)"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "AI Chat User",
   "read": 1,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "share": 0
  },
  {
   "role": "AI Chatbot User",
   "read": 1,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "share": 0
  },
  {
   "role": "AI MCP User",
   "read": 1,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "share": 0
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "modified": "2026-10-11 07:00:00.000000",
 "field_order": [
  "provider_name",
  "enabled",
  "is_default",
  "cb_identity",
  "provider_type",
  "description",
  "section_connection",
  "base_url",
  "api_key",
  "cb_connection",
  "request_timeout",
  "strict_tool_calling",
  "default_reasoning_effort",
  "extra_request_json",
  "section_models",
  "default_model",
  "models"
 ]
}

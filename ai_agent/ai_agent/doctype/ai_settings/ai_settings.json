   "fieldtype": "Check",
   "label": "Allow Admin Conversation Audit",
   "description": "When enabled, System Managers can read other users' agent conversations. Every such read is recorded in Access Log. Disabled: each user sees only their own conversations."
  },
  {
   "fieldname": "section_memory",
   "fieldtype": "Section Break",
   "label": "Memory"
  },
  {
   "fieldname": "enable_memory",
   "fieldtype": "Check",

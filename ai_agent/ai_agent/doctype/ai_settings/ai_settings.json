  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_notifications",
   "fieldtype": "Check",
   "label": "Notifications",
   "description": "Email and system notifications on documents. Recipients outside the site's users need an explicit confirmation."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_workflows",
   "fieldtype": "Check",
   "label": "Workflows"
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_dashboards",
   "fieldtype": "Check",
   "label": "Dashboards and Workspaces",
   "description": "Number cards, dashboard charts, workspaces and the sidebar."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_web",
   "fieldtype": "Check",
   "label": "Web Pages and Web Forms",
   "description": "Public pages and forms. Also needs the Website Manager role."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_permissions",
   "fieldtype": "Check",
   "label": "Role Permissions",
   "description": "Always needs a second approver, whatever the setting below says."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_doctypes",
   "fieldtype": "Check",
   "label": "New DocTypes"

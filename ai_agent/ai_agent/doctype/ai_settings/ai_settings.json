  },
  {
   "fieldname": "store_full_tool_results",
   "fieldtype": "Check",
   "label": "Store Full Tool Results"
  },
  {
   "fieldname": "cb_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_approval_ttl_minutes",

   "fieldtype": "Check",
   "label": "Server Scripts"
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_reports",
   "fieldtype": "Check",
   "label": "Custom Reports",
   "description": "Report Builder and Query Report; Python (Script) reports also need Script Manager and server scripts enabled."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_print_formats",
   "fieldtype": "Check",
   "label": "Print Formats"

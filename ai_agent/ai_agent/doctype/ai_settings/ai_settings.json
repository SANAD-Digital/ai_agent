   "fieldtype": "Check",
   "label": "Thinking Mode",
   "hidden": 1
  },
  {
   "default": "medium",
   "fieldname": "default_reasoning_effort",
   "fieldtype": "Select",
   "label": "Default Reasoning Effort",
   "options": "low\nmedium\nhigh"
  },
  {
   "default": "0",
   "fieldname": "strict_tool_calling",
   "fieldtype": "Check",
   "label": "Strict Tool Calling",
   "hidden": 1
  },
  {
   "fieldname": "section_web",
   "fieldtype": "Section Break",
   "label": "Web Browsing"
  },
  {
   "default": "0",
   "fieldname": "enable_web_browsing",
   "fieldtype": "Check",
   "label": "Allow Web Browsing",
   "description": "The assistant can search the internet and read public pages. Search words and page addresses are sent to the search engine."
  },
  {
   "default": "DuckDuckGo",
   "depends_on": "eval:doc.enable_web_browsing",
   "fieldname": "web_search_provider",
   "fieldtype": "Select",
   "label": "Search Engine",
   "options": "DuckDuckGo\nBrave Search\nTavily\nSearXNG",
   "description": "DuckDuckGo needs no key. Brave Search and Tavily need an API key; SearXNG needs your server address."
  },
  {
   "fieldname": "cb_web",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.enable_web_browsing && in_list(['Brave Search','Tavily'], doc.web_search_provider)",

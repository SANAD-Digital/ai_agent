  {
   "description": "Users with this role may approve AI actions in addition to System Managers. Leave empty to allow System Managers only.",
   "fieldname": "approver_role",
   "fieldtype": "Link",
   "label": "Approver Role",
   "options": "Role"
  },
  {
   "fieldname": "cb_approvals2",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "description": "When enabled, the user who requested an action cannot approve it themselves.",
   "fieldname": "require_four_eyes",
   "fieldtype": "Check",
   "label": "Require Four-Eyes Approval"
  },
  {
   "default": "0",
   "description": "Off (default): the agent never submits or cancels documents; submit/cancel tools are hidden and old requests are refused at execution.",
   "fieldname": "allow_submit_cancel_actions",
   "fieldtype": "Check",
   "label": "Allow Submit / Cancel Actions"
  },
  {
   "default": "1",
   "fieldname": "allow_auto_approval",
   "fieldtype": "Check",
   "label": "Allow Auto-Approval",
   "description": "Users may switch a conversation to auto-approval: creating and editing documents then run without asking, under the user's own permissions. Submit, cancel, workflow changes and email always ask. Not available while Four-Eyes Approval is on."
  },
  {
   "collapsible": 1,
   "description": "Let the assistant request changes to how the system works: fields and form properties, scripts, reports, print formats, notifications, workflows, naming, dashboards and workspaces, web pages and forms, role permissions and new DocTypes. Every change is checked, shown in full on its approval card and runs only after a person with the Frappe roles approves it (never by auto-approval).",
   "fieldname": "section_customization",
   "fieldtype": "Section Break",
   "label": "Customization"
  },
  {
   "default": "0",
   "description": "Master switch. Only System Managers see the customization tools; server scripts and query reports also need Script Manager.",
   "fieldname": "allow_customization_actions",
   "fieldtype": "Check",
   "label": "Allow Customization Requests"
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_fields",
   "fieldtype": "Check",
   "label": "Fields, Form Properties, List Views and Naming",
   "description": "Custom fields, field and form properties, list view columns and settings, and how new documents are named (naming rules and series)."
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "fieldname": "allow_customize_client_scripts",
   "fieldtype": "Check",
   "label": "Client Scripts"
  },
  {
   "default": "0",
   "depends_on": "allow_customization_actions",
   "description": "DocType Event and API scripts for signed-in users. Needs server_script_enabled in common_site_config.",

   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "fieldname": "default_provider",
   "fieldtype": "Link",
   "options": "AI Provider",
   "label": "Default Provider",
   "description": "Used when an agent or a conversation does not pick a provider. Keys, URLs and models are set on the provider itself (AI Provider list)."
  },
  {
   "default": "OpenAI",
   "fieldname": "provider_type",
   "fieldtype": "Select",
   "label": "Provider Type",
   "options": "OpenAI\nOpenAI Compatible\nOllama\nAnthropic",
   "hidden": 1
  },
  {
   "depends_on": "eval:doc.provider_type != 'OpenAI'",

 "content": "[{\"id\": \"ai-head\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>AI Assistant</b></span>\", \"col\": 12}}, {\"id\": \"ai-intro\", \"type\": \"paragraph\", \"data\": {\"text\": \"Ask about your data in the chat. Type <b>/</b> to pick a skill that takes you straight to an area, or a plugin that gives you a file (Excel, PDF, image or chart). Who can use what is set in the permissions table in the settings.\", \"col\": 12}}, {\"id\": \"ai-sc-0\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"AI Chat\", \"col\": 3}}, {\"id\": \"ai-sc-1\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Approval Requests\", \"col\": 3}}, {\"id\": \"ai-sc-2\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Skills\", \"col\": 3}}, {\"id\": \"ai-sc-3\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Plugins\", \"col\": 3}}, {\"id\": \"ai-sc-4\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Permissions\", \"col\": 3}}, {\"id\": \"ai-spacer\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"ai-card-0\", \"type\": \"card\", \"data\": {\"card_name\": \"Usage\", \"col\": 6}}, {\"id\": \"ai-card-1\", \"type\": \"card\", \"data\": {\"card_name\": \"Capabilities\", \"col\": 6}}, {\"id\": \"ai-card-2\", \"type\": \"card\", \"data\": {\"card_name\": \"Monitoring\", \"col\": 6}}, {\"id\": \"ai-card-3\", \"type\": \"card\", \"data\": {\"card_name\": \"Settings\", \"col\": 6}}]",
